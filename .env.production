# 生产构建专用配置（可提交入库，不含任何私密 Key）
# 说明：Vite 构建时 import.meta.env.VITE_* 会被静态替换注入 bundle，
# 因此生产构建必须用本文件覆盖 .env —— VITE_AI_API_KEY 保持为空（零 Key 进 bundle），
# AI 走 Edge Function 代理（VITE_AI_ENDPOINT），需登录用户 JWT。
# 本地开发（npm run dev）仍读 .env（含 VITE_AI_API_KEY 直连 DeepSeek，调试方便）。

# Supabase（anon key 为公开 publishable key，可安全放前端）
VITE_SUPABASE_URL=https://njoujkyvafmocgpgbxau.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_s6bPUnUomIqK-XElw2G7pA_DXYBW6gX

# AI 代理（Key 在服务端 Edge Function Secrets，前端零 Key）
VITE_AI_API_KEY=
VITE_AI_ENDPOINT=https://njoujkyvafmocgpgbxau.supabase.co/functions/v1/ai-proxy