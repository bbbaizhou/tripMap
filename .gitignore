# 依赖
node_modules

# 构建产物（CI 自动构建部署，无需提交）
dist/

# TypeScript 构建缓存
*.tsbuildinfo

# 编译产物（源文件为 vite.config.ts）
vite.config.js
vite.config.d.ts

# 本地虚拟环境
.venv/

# 本地开发工具配置（含本机路径，不入库）
.claude/settings.local.json

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
.tmp_*

# Python 缓存
__pycache__/
*.pyc

# Supabase 环境变量（本地凭据，不入库；.env.example 提交）
.env
.env.local
